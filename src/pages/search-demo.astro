---
import Layout from '../layouts/Layout.astro';
import SearchWidget from '../demos/search/SearchWidget';

export const prerender = true;
---

<Layout title="Live search">
	<main>
		<p class="kicker">React island</p>
		<h1>Live search</h1>
		<p class="lead">
			Type to filter a local catalog of interface components. Matches update as
			you type, matched text is highlighted, Clear resets the query, and an
			empty state appears when nothing matches.
		</p>
		<p class="back">
			<a href="/">Back home</a>
		</p>
		<SearchWidget client:load />
	</main>
</Layout>

<style>
	main {
		margin: auto;
		padding: 1.5rem 1rem 3rem;
		max-width: 68ch;
	}

	h1 {
		margin: 0.5rem 0 1rem;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.15;
	}

	.kicker {
		margin: 2rem 0 0;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #4f39fa;
	}

	.lead {
		margin: 0 0 0.75rem;
		font-size: 1.15rem;
		line-height: 1.6;
	}

	.back {
		margin: 0 0 1.5rem;
	}

	.back a {
		color: #4f39fa;
	}
</style>
