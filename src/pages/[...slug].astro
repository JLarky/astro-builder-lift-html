---
export const prerender = false;

import {
	fetchOneEntry,
	getBuilderSearchParams,
	isPreviewing,
} from '@builder.io/sdk-react';
import BuilderContent from '../builder/BuilderContent';
import { collectComponents } from '../builder/collect-content';
import type { RegisteredName } from '../builder/builder-registry';
import { wcLoaders } from '../builder/wc-loaders';

const BUILDER_MODEL = 'page';
const DEMO_PUBLIC_API_KEY = 'dbca46c0d48940b09ef11fa8978c6dea';
const BUILDER_API_KEY =
	import.meta.env.PUBLIC_BUILDER_API_KEY || DEMO_PUBLIC_API_KEY;

/**
 * `isEditing()` from the SDK only returns true inside the editor iframe, so it
 * is useless during SSR. Preview mode is `builder.preview=` and does work on
 * the server via `isPreviewing(searchParams)`.
 */
function getRequestMode(url: URL) {
	const sp = url.searchParams;
	const editing =
		sp.has('__builder_editing__') || sp.has('builder.frameEditing');
	const previewing = editing || isPreviewing(sp);
	return { editing, previewing };
}

const pathname = Astro.url.pathname;
const mode = getRequestMode(Astro.url);
const content = await fetchOneEntry({
	model: BUILDER_MODEL,
	apiKey: BUILDER_API_KEY,
	userAttributes: { urlPath: pathname },
	options: getBuilderSearchParams(Astro.url.searchParams),
	enrich: true,
});

if (!content && !mode.previewing) {
	return Astro.rewrite('/404');
}

const loaders = mode.editing
	? Object.values(wcLoaders).flat()
	: [...collectComponents(content)].flatMap(
			(name) => wcLoaders[name as RegisteredName] ?? [],
		);
const uniqueLoaders = [...new Set(loaders)];
const title =
	(typeof content?.data?.title === 'string' && content.data.title) ||
	'Builder.io';
const description =
	typeof content?.data?.description === 'string'
		? content.data.description
		: undefined;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
	</head>
	<body>
		<BuilderContent
			client:idle={mode.previewing}
			apiKey={BUILDER_API_KEY}
			model={BUILDER_MODEL}
			content={content}
			isEditing={mode.previewing}
		/>
		{uniqueLoaders.map((Loader) => (
			<Loader />
		))}
	</body>
</html>
