---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

export const prerender = true;

const YOUTUBE_VIDEO_URL = 'https://youtube.com/live/gFVBliU7k5k';

function youtubeEmbedSrc(url: string): string | null {
	if (!url.startsWith('https://')) return null;
	try {
		const parsed = new URL(url);
		if (parsed.hostname === 'youtu.be') {
			const id = parsed.pathname.replace(/^\//, '');
			return id ? `https://www.youtube.com/embed/${id}` : null;
		}
		if (
			parsed.hostname === 'www.youtube.com' ||
			parsed.hostname === 'youtube.com'
		) {
			const watchId = parsed.searchParams.get('v');
			if (watchId) return `https://www.youtube.com/embed/${watchId}`;
			const parts = parsed.pathname.split('/').filter(Boolean);
			const marker = parts[0];
			const id = parts[1];
			if (
				(marker === 'embed' || marker === 'shorts' || marker === 'live') &&
				id
			) {
				return `https://www.youtube.com/embed/${id}`;
			}
		}
		return null;
	} catch {
		return null;
	}
}

const videoEmbedSrc = youtubeEmbedSrc(YOUTUBE_VIDEO_URL);
---

<Layout title="astro-builder-lift-html">
	<main>
		<p class="kicker">Astro · Builder.io · lift-html</p>
		<h1>
			Builder pages with a <span class="text-gradient">lift-html</span> client
		</h1>
		<p class="lead">
			These pages are published from Builder.io and rendered by Astro. The
			editor still edits React components. Where a block has a web component,
			visitors load that element and leave React on the server. The sections
			below are the live pages for that split.
		</p>

		<section class="video" aria-labelledby="walkthrough-heading">
			<h2 id="walkthrough-heading">Walkthrough</h2>
			{videoEmbedSrc ? (
				<iframe
					class="video-frame"
					src={videoEmbedSrc}
					title="Walkthrough of the Builder pages and the lift-html client"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					allowfullscreen
				/>
			) : null}
			<p>
				<a href={YOUTUBE_VIDEO_URL}>Watch the walkthrough</a> of the published
				pages and the editing path.
			</p>
		</section>

		<section aria-labelledby="lift-counter-heading">
			<h2 id="lift-counter-heading">Lift Counter</h2>
			<p>
				A Builder custom component is React. Hydrating it on the published page
				sends React and the Builder client with every interactive block.
				lift-html keeps the React component for the editor and moves the
				interaction into a web component, so the page ships only that element.
				On the counter, the client script drops from 100 kilobytes to 7
				kilobytes. The published page server-renders the markup, and the + and −
				buttons run from the element.
			</p>
			<ul role="list" class="link-card-grid">
				<Card
					href="/builder-lift-counter"
					title="Lift Counter"
					body="Published counter. The + and − buttons run in a lift-html element."
				/>
			</ul>
		</section>

		<section aria-labelledby="escape-hatch-heading">
			<h2 id="escape-hatch-heading">React escape hatch</h2>
			<p>
				Existing React can be registered as a Builder custom component and
				reused when there is no web component yet. That escape hatch does not
				follow lift-html’s rules: visitors get server-rendered markup, and the
				React behavior stays with the editor.
			</p>
			<p>
				The lift FAQ is the same tabbed FAQ built as the proper split. React
				draws it in the editor, and a lift-html element runs the tabs and
				answers for visitors. The React FAQ is the escape hatch: the existing
				React FAQ component, registered as-is.
			</p>
			<ul role="list" class="link-card-grid">
				<Card
					href="/builder-lift-faq"
					title="Lift FAQ"
					body="Tabbed FAQ with a lift-html element for visitors and React for the editor."
				/>
				<Card
					href="/builder-react-faq"
					title="React FAQ"
					body="The existing React FAQ, reused as a Builder custom component."
				/>
			</ul>
		</section>

		<section aria-labelledby="broken-faq-heading">
			<h2 id="broken-faq-heading">Broken React FAQ</h2>
			<p>
				Publishing a React FAQ on its own leaves the block as server HTML.
				<code>useState</code> and <code>useEffect</code> never run, because
				React runs on the server and the published page does not start it in the
				browser. Tabs and answers stay frozen.
			</p>
			<p>
				The same URL with <code>__builder_editing__</code> hydrates the page, so
				the FAQ responds. That mode still boots the full React and Builder
				client.
			</p>
			<ul role="list" class="link-card-grid">
				<Card
					href="/builder-react-faq-broken"
					title="React FAQ (broken)"
					body="Published page. React never starts in the browser, so the FAQ does not respond."
				/>
				<Card
					href="/builder-react-faq-broken?__builder_editing__"
					title="React FAQ (editing)"
					body="Editing mode runs the FAQ by booting the full React and Builder client."
				/>
			</ul>
		</section>

		<section aria-labelledby="links-heading">
			<h2 id="links-heading">Links</h2>
			<ul role="list" class="link-card-grid">
				<Card
					href="https://github.com/JLarky/astro-builder-lift-html"
					title="GitHub"
					body="Source for the Astro app, the Builder components, and the loaders."
				/>
				<Card
					href="https://github.com/JLarky/lift-html"
					title="lift-html"
					body="The library that turns the editor’s React components into elements for visitors."
				/>
				<Card
					href="https://www.builder.io/"
					title="Builder.io"
					body="The visual editor these pages are authored in."
				/>
			</ul>
		</section>
	</main>
</Layout>

<style>
	h1 {
		margin: 0.5rem 0 1.5rem;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.15;
	}

	main {
		margin: auto;
		padding: 1.5rem 1rem 3rem;
		max-width: 68ch;
	}

	.kicker {
		margin: 2rem 0 0;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #4f39fa;
	}

	.text-gradient {
		font-weight: 900;
		background-image: linear-gradient(0deg, #4f39fa, #da62c4);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 100% 200%;
		background-position-y: 100%;
		border-radius: 0.4rem;
		animation: pulse 4s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			background-position-y: 0%;
		}
		50% {
			background-position-y: 80%;
		}
	}

	.lead,
	section p {
		line-height: 1.6;
	}

	.lead {
		margin: 0 0 2rem;
		font-size: 1.15rem;
	}

	section {
		margin: 0 0 2.5rem;
	}

	section h2 {
		margin: 0 0 0.4rem;
	}

	section p {
		margin: 0.6rem 0 0;
	}

	code {
		font-size: 0.875em;
		border: 0.1em solid var(--color-border);
		border-radius: 4px;
		padding: 0.15em 0.25em;
	}

	section a {
		color: inherit;
	}

	.video-frame {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		margin-top: 0.75rem;
		border: 0;
		border-radius: 0.5rem;
		background: white;
	}

	.link-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
		gap: 1rem;
		padding: 0;
		margin: 1rem 0 0;
	}
</style>
