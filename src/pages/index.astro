---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

export const prerender = true;

const YOUTUBE_VIDEO_URL = 'https://youtube.com/live/gFVBliU7k5k';

function youtubeEmbedSrc(url: string): string | null {
	if (!url.startsWith('https://')) return null;
	try {
		const parsed = new URL(url);
		if (parsed.hostname === 'youtu.be') {
			const id = parsed.pathname.replace(/^\//, '');
			return id ? `https://www.youtube.com/embed/${id}` : null;
		}
		if (
			parsed.hostname === 'www.youtube.com' ||
			parsed.hostname === 'youtube.com'
		) {
			const watchId = parsed.searchParams.get('v');
			if (watchId) return `https://www.youtube.com/embed/${watchId}`;
			const parts = parsed.pathname.split('/').filter(Boolean);
			const marker = parts[0];
			const id = parts[1];
			if (
				(marker === 'embed' || marker === 'shorts' || marker === 'live') &&
				id
			) {
				return `https://www.youtube.com/embed/${id}`;
			}
		}
		return null;
	} catch {
		return null;
	}
}

const videoEmbedSrc = youtubeEmbedSrc(YOUTUBE_VIDEO_URL);
---

<Layout title="astro-builder-lift-html">
	<main>
		<p class="kicker">Astro · Builder.io · lift-html</p>
		<h1>
			Builder.io pages in Astro with a{' '}
			<span class="text-gradient">lift-html</span> bundle
		</h1>
		<p class="lead">
			<a href="https://www.builder.io/">Builder.io</a> pages in Astro: visitors
			get <a href="https://github.com/JLarky/lift-html">lift-html</a>, the
			editor keeps React, and the bundle drops from 300 kilobytes gzipped to 10
			kilobytes gzipped.
		</p>

		<section class="video">
			{videoEmbedSrc ? (
				<>
					<iframe
						class="video-frame"
						src={videoEmbedSrc}
						title="astro-builder-lift-html walkthrough"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					/>
					<p>
						<a href={YOUTUBE_VIDEO_URL}>{YOUTUBE_VIDEO_URL}</a>
					</p>
				</>
			) : (
				<p>
					<a href={YOUTUBE_VIDEO_URL}>{YOUTUBE_VIDEO_URL}</a>
				</p>
			)}
		</section>

		<section>
			<h2>React escape hatch</h2>
			<p>
				The escape hatch is a React component registered as a Builder custom
				component with no web component: the editor can still hydrate it, and a
				published page server-renders it without shipping that React component
				to the client.
			</p>
		</section>

		<ul role="list" class="link-card-grid">
			<Card
				href="/react-faq"
				title="React FAQ"
				body="A plain React tabbed FAQ on its own route. Not a Builder custom component."
			/>
			<Card
				href="https://github.com/JLarky/astro-builder-lift-html"
				title="GitHub"
				body="Source and README."
			/>
			<Card
				href="https://github.com/JLarky/lift-html"
				title="lift-html"
				body="The library that defines the my-counter element."
			/>
			<Card
				href="https://www.builder.io/"
				title="Builder.io"
				body="The visual editor."
			/>
		</ul>
	</main>
</Layout>

<style>
	h1 {
		margin: 0.5rem 0 1.5rem;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.15;
	}

	main {
		margin: auto;
		padding: 1.5rem 1rem 3rem;
		max-width: 68ch;
	}

	.kicker {
		margin: 2rem 0 0;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #4f39fa;
	}

	.text-gradient {
		font-weight: 900;
		background-image: linear-gradient(0deg, #4f39fa, #da62c4);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 100% 200%;
		background-position-y: 100%;
		border-radius: 0.4rem;
		animation: pulse 4s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			background-position-y: 0%;
		}
		50% {
			background-position-y: 80%;
		}
	}

	.lead,
	section p {
		line-height: 1.6;
	}

	.lead {
		margin: 0 0 2rem;
		font-size: 1.15rem;
	}

	section {
		margin: 0 0 1.75rem;
	}

	section h2 {
		margin: 0 0 0.4rem;
	}

	section p {
		margin: 0.6rem 0 0;
	}

	code {
		font-size: 0.875em;
		border: 0.1em solid var(--color-border);
		border-radius: 4px;
		padding: 0.15em 0.25em;
	}

	section a {
		color: inherit;
	}

	.video-frame {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		margin-top: 0.75rem;
		border: 0;
		border-radius: 0.5rem;
		background: white;
	}

	.link-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
		gap: 1rem;
		padding: 0;
		margin: 2rem 0 0;
	}
</style>
