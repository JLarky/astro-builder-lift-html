---
import type { BuilderContent as BuilderContentType } from '@builder.io/sdk-react';
import BuilderContent from '../builder/BuilderContent';

type Props = {
	isEditing: boolean;
	content: BuilderContentType | null;
	model: string;
	apiKey: string;
};

const { isEditing, content, model, apiKey } = Astro.props;
---

<>
	{isEditing ? (
		<BuilderContent
			client:idle
			apiKey={apiKey}
			model={model}
			content={content}
			isEditing={true}
		>
			<span slot="outlet">this is outlet</span>
			<span slot="footer">this is footer</span>
			<span slot="header">this is header</span>
		</BuilderContent>
	) : (
		<BuilderContent
			apiKey={apiKey}
			model={model}
			content={content}
			isEditing={false}
		/>
	)}
</>
