---
import type { BuilderContent as BuilderContentType } from '@builder.io/sdk-react';
import BuilderContent from '../builder/BuilderContent';
import type { Loaders } from '../builder/builder';

type Props = {
	isEditing: boolean;
	content: BuilderContentType | null;
	model: string;
	apiKey: string;
	loaders: Loaders;
};

const { isEditing, content, model, apiKey, loaders } = Astro.props;
---

<>
	{isEditing ? (
		<BuilderContent
			client:idle
			apiKey={apiKey}
			model={model}
			content={content}
			isEditing={true}
		>
			<slot name="outlet" slot="outlet" />
			<slot name="footer" slot="footer" />
			<slot name="header" slot="header" />
		</BuilderContent>
	) : (
		<BuilderContent
			apiKey={apiKey}
			model={model}
			content={content}
			isEditing={false}
		>
			<slot name="outlet" slot="outlet" />
			<slot name="footer" slot="footer" />
			<slot name="header" slot="header" />
		</BuilderContent>
	)}
	{loaders.map((Loader) => (
		<Loader />
	))}
</>
